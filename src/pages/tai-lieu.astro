---
// Trang Tài liệu: lưới thẻ sản phẩm (ảnh · nhãn · tên · mô tả · giá · Mua ngay).
// Dữ liệu sản phẩm ở src/data/products.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { PRODUCTS } from '../data/products';
// Nhóm để lọc: theo chữ đầu tên sản phẩm ("Template…" / "Ebook…")
const kindOf = (name: string) => (/^template/i.test(name) ? 'template' : /^ebook/i.test(name) ? 'ebook' : 'other');
---

<BaseLayout
  title="Tài liệu Marketing"
  description="Template, ebook và checklist Marketing thực chiến của Sunz Làm Marketing — dùng được ngay cho công việc."
>
  <section class="page-head">
    <div class="container">
      <h1><span data-i18n-vi="Tài liệu" data-i18n-en="Marketing">Tài liệu</span> <span class="hl" data-i18n-vi="Marketing" data-i18n-en="Resources">Marketing</span></h1>
      <p data-i18n="resources.lead">Template, ebook và checklist thực chiến — mua về là dùng được ngay.</p>
      <div class="pd-filters" role="group" aria-label="Lọc tài liệu">
        <button type="button" class="pd-filter" data-filter="template" aria-pressed="false">Template</button>
        <button type="button" class="pd-filter" data-filter="ebook" aria-pressed="false">Ebook</button>
        <button type="button" class="pd-filter active" data-filter="all" aria-pressed="true" data-i18n-vi="Tất cả" data-i18n-en="All">Tất cả</button>
      </div>
    </div>
  </section>

  <section class="container" style="padding-block:var(--space-content-top) var(--space-section)">
    <div class="pd-grid">
      {PRODUCTS.map((p) => (
        <div class="pd-item" data-kind={kindOf(p.name.vi)}>
          <ProductCard product={p} />
        </div>
      ))}
    </div>
  </section>
  <PaymentModal />
</BaseLayout>

<style>
  .pd-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }
  .pd-filter {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--ink-soft);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: 0.15s;
  }
  .pd-filter:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .pd-filter.active {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .pd-item {
    display: flex;
    flex-direction: column;
  }
  .pd-item > :global(.pd-card) {
    flex: 1;
  }
  .pd-item.is-hidden {
    display: none;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  /* 4 thẻ/dòng: thu nhỏ chữ, khoảng đệm để thẻ gọn */
  .pd-grid :global(.pd-card) {
    border-radius: 22px;
  }
  .pd-grid :global(.pd-body) {
    padding: 16px 16px 18px;
  }
  .pd-grid :global(.pd-tag) {
    max-width: 100%;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pd-grid :global(.pd-name) {
    margin: 12px 0 6px;
    font-size: 1rem;
  }
  .pd-grid :global(.pd-desc) {
    font-size: 0.86rem;
  }
  .pd-grid :global(.pd-more) {
    margin: 8px 0 14px;
    font-size: 0.82rem;
  }
  .pd-grid :global(.pd-foot) {
    padding-top: 14px;
    gap: 8px;
  }
  .pd-grid :global(.pd-price) {
    font-size: 1.2rem;
  }
  .pd-grid :global(.pd-old) {
    gap: 4px;
    font-size: 0.74rem;
    white-space: nowrap;
  }
  .pd-grid :global(.pd-off) {
    font-size: 0.66rem;
    padding: 1px 5px;
  }
  .pd-grid :global(.pd-foot .buy-btn) {
    padding: 10px 12px;
    font-size: 0.88rem;
    border-radius: 12px;
  }
  @media (max-width: 1180px) {
    .pd-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 960px) {
    .pd-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pd-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.pd-filter');
  const items = document.querySelectorAll<HTMLElement>('.pd-item');
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter || 'all';
      filters.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      items.forEach((it) => it.classList.toggle('is-hidden', f !== 'all' && it.dataset.kind !== f));
    });
  });
</script>
