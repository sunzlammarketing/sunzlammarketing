---
import BaseLayout from './BaseLayout.astro';
import { getCategory } from '../data/categories';
import { absolute } from '../data/site';
import { PRODUCTS, RELATED_BY_CATEGORY, productUrl, effectivePrice, formatVnd } from '../data/products';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, readingTime, lang } =
  post.data;
// Ngày sửa nội dung gần nhất: updatedDate nếu có, không thì chính ngày đăng
const modified = updatedDate && updatedDate > pubDate ? updatedDate : pubDate;
const AUTHOR = { name: 'Sunz Làm Marketing', url: '/gioi-thieu' };
const pageUrl = absolute(`/blog/${post.slug}`);
const en = lang === 'en';
const cat = getCategory(category);
const catName = cat ? (en ? cat.nameEn : cat.name) : '';
const fmt = (d: Date) =>
  d.toLocaleDateString(en ? 'en-US' : 'vi-VN', { day: '2-digit', month: 'long', year: 'numeric' });
const dateStr = fmt(pubDate);
// Tài liệu dùng kèm bài viết (theo chủ đề) → dẫn người đọc blog sang trang sản phẩm
const relatedProducts = (RELATED_BY_CATEGORY[category] ?? [])
  .map((slug) => PRODUCTS.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);
// Dữ liệu có cấu trúc cho Google: BlogPosting (tác giả, ngày đăng/cập nhật)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: pubDate.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@type': 'Organization', name: AUTHOR.name, url: absolute(AUTHOR.url) },
  publisher: { '@type': 'Organization', name: 'Sunz Làm Marketing', logo: { '@type': 'ImageObject', url: absolute('/logo-full.png') } },
  image: absolute('/logo-full.png'),
  mainEntityOfPage: pageUrl,
  keywords: tags.join(', '),
};
const t = {
  home: en ? 'Home' : 'Trang chủ',
  blog: en ? 'Articles' : 'Bài viết',
  read: en ? 'min read' : 'phút đọc',
  by: en ? 'By' : 'Tác giả',
  updated: en ? 'Updated' : 'Cập nhật',
  back: en ? '← View all articles' : '← Xem tất cả bài viết',
  contact: en ? 'Contact us' : 'Liên hệ với chúng tôi',
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <meta name="author" content={AUTHOR.name} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <article class="post">
    <div class="container post-head">
      {cat && (
        <a href={`/chu-de/${cat.slug}`} class="cat-chip" style={`--c:${cat.color}`}>
          {cat.icon} {catName}
        </a>
      )}
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="byline">
        <span class="byline-meta">
          {t.by} <a href={AUTHOR.url} rel="author" class="author">{AUTHOR.name}</a> ·
          <time datetime={pubDate.toISOString()}>{dateStr}</time>
          {modified > pubDate && <> · {t.updated} <time datetime={modified.toISOString()}>{fmt(modified)}</time></>}
          {readingTime && <>{` · ⏱ ${readingTime} ${t.read}`}</>}
        </span>
      </div>
    </div>

    <div class="container post-body">
      <div class="panel post-panel">
      <div class="prose">
        <slot />
      </div>

      {relatedProducts.length > 0 && (
        <aside class="rel">
          <b class="rel-title">{en ? 'Put this into practice' : 'Áp dụng ngay bài này với'}</b>
          <div class="rel-list">
            {relatedProducts.map((p) => {
              const ep = effectivePrice(p);
              const price = ep.price === 0 ? (en ? 'Free' : 'Miễn phí') : ep.price != null ? formatVnd(ep.price) : en ? 'Contact us' : 'Liên hệ';
              return (
                <a class="rel-item" href={productUrl(p)} style={`--c:${p.color}`}>
                  <span class="rel-icon" aria-hidden="true">{p.icon}</span>
                  <span class="rel-text">
                    <span class="rel-name">{en ? p.name.en : p.name.vi}</span>
                    <span class="rel-meta">
                      <b class={ep.price === 0 ? 'rel-free' : ''}>{price}</b> · {en ? 'View details →' : 'Xem chi tiết →'}
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </aside>
      )}

      {tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}

      <div class="post-cta">
        <a href="/blog" class="btn btn-ghost">{t.back}</a>
        <a href="/lien-he" class="btn btn-primary">{t.contact}</a>
      </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-bottom: var(--space-section);
  }
  .post-head {
    max-width: 760px;
    padding-top: var(--space-head-top);
    text-align: center;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 20px;
  }
  .crumbs a {
    color: var(--ink-faint);
  }
  .crumbs a:hover {
    color: var(--brand);
  }
  .crumbs span {
    margin-inline: 4px;
  }
  .cat-chip {
    display: inline-block;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 0.72rem;
  }
  .cat-chip:hover {
    text-decoration: none;
  }
  .post-head h1 {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    text-wrap: balance;
    line-height: 1.15;
    margin: 18px 0 14px;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin: 0 auto 28px;
    max-width: 620px;
  }
  .byline {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 0 8px;
    width: 100%;
  }
  .byline-meta {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .byline-meta .author {
    font-weight: 700;
    color: var(--ink-soft);
  }
  .post-body {
    max-width: 820px;
    padding-block: 24px 20px;
  }
  .post-panel {
    padding: 40px 48px;
  }
  @media (max-width: 640px) {
    .post-panel {
      padding: 26px 20px;
    }
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
  }
  .tag {
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .rel {
    margin-top: 40px;
    padding: 22px;
    border-radius: 20px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
  .rel-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 900;
    margin-bottom: 14px;
  }
  .rel-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .rel {
      padding: 18px 16px;
    }
    .rel-list {
      grid-template-columns: 1fr;
    }
  }
  .rel-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--ink);
    transition: border-color 0.15s, transform 0.15s;
  }
  .rel-item:hover {
    text-decoration: none;
    border-color: var(--c);
    transform: translateY(-2px);
  }
  .rel-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-size: 1.4rem;
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .rel-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .rel-name {
    font-weight: 800;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .rel-meta {
    font-size: 0.82rem;
    color: var(--brand);
    font-weight: 700;
  }
  .rel-meta b {
    color: var(--ink);
  }
  .rel-meta .rel-free {
    color: #16a34a;
  }
  .post-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
</style>
